<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Ocean World</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #eaf8ff;
        }

        .hero {
            background: linear-gradient(135deg, #0077b6, #00b4d8);
            color: white;
            padding: 60px 20px;
            text-align: center;
        }

        .animal-card {
            transition: transform 0.2s;
        }

        .animal-card:hover {
            transform: translateY(-5px);
        }

        .animal-icon {
            font-size: 70px;
            text-align: center;
            padding: 25px;
            background-color: #caf0f8;
        }
    </style>
</head>

<body>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#">🌊 My Ocean World</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="#">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#animals">Animals</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about">About</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <h1 class="display-3 fw-bold">🌊 My Ocean World</h1>
            <p class="lead">
                Discover amazing animals that live beneath the ocean!
            </p>

            <!-- Loading Spinner -->
            <div class="spinner-border text-light mt-3" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <main class="container my-5">

        <h2 class="text-center mb-4">🐠 Ocean Animals</h2>

        <div class="row g-4" id="animals">

            <!-- Dolphin Card -->
            <div class="col-md-4">
                <div class="card animal-card shadow h-100">
                    <div class="animal-icon">🐬</div>

                    <div class="card-body">
                        <h5 class="card-title">Dolphin</h5>
                        <p class="card-text">
                            Dolphins are intelligent marine mammals that
                            communicate using sounds and live in groups.
                        </p>
                        <span class="badge bg-primary">Mammal</span>
                    </div>
                </div>
            </div>

            <!-- Shark Card -->
            <div class="col-md-4">
                <div class="card animal-card shadow h-100">
                    <div class="animal-icon">🦈</div>

                    <div class="card-body">
                        <h5 class="card-title">Shark</h5>
                        <p class="card-text">
                            Sharks are powerful ocean predators with
                            excellent senses and streamlined bodies.
                        </p>
                        <span class="badge bg-danger">Predator</span>
                    </div>
                </div>
            </div>

            <!-- Turtle Card -->
            <div class="col-md-4">
                <div class="card animal-card shadow h-100">
                    <div class="animal-icon">🐢</div>

                    <div class="card-body">
                        <h5 class="card-title">Sea Turtle</h5>
                        <p class="card-text">
                            Sea turtles spend most of their lives in the
                            ocean and can travel very long distances.
                        </p>
                        <span class="badge bg-success">Reptile</span>
                    </div>
                </div>
            </div>

            <!-- Octopus Card -->
            <div class="col-md-4">
                <div class="card animal-card shadow h-100">
                    <div class="animal-icon">🐙</div>

                    <div class="card-body">
                        <h5 class="card-title">Octopus</h5>
                        <p class="card-text">
                            Octopuses have eight arms and are known for
                            their intelligence and ability to camouflage.
                        </p>
                        <span class="badge bg-warning text-dark">Invertebrate</span>
                    </div>
                </div>
            </div>

            <!-- Fish Card -->
            <div class="col-md-4">
                <div class="card animal-card shadow h-100">
                    <div class="animal-icon">🐠</div>

                    <div class="card-body">
                        <h5 class="card-title">Tropical Fish</h5>
                        <p class="card-text">
                            Tropical fish live in warm ocean waters and
                            often have bright and colorful patterns.
                        </p>
                        <span class="badge bg-info text-dark">Fish</span>
                    </div>
                </div>
            </div>

            <!-- Whale Card -->
            <div class="col-md-4">
                <div class="card animal-card shadow h-100">
                    <div class="animal-icon">🐋</div>

                    <div class="card-body">
                        <h5 class="card-title">Whale</h5>
                        <p class="card-text">
                            Whales are some of the largest animals on Earth
                            and live in oceans around the world.
                        </p>
                        <span class="badge bg-dark">Mammal</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- Loading Section -->
        <div class="text-center my-5">
            <h4>Loading more ocean creatures...</h4>

            <div class="spinner-grow text-primary m-2" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>

            <div class="spinner-grow text-info m-2" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>

            <div class="spinner-grow text-success m-2" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>

        <!-- Pagination -->
        <nav aria-label="Ocean pages">
            <ul class="pagination justify-content-center">
                <li class="page-item disabled">
                    <a class="page-link" href="#">Previous</a>
                </li>

                <li class="page-item active">
                    <a class="page-link" href="#">1</a>
                </li>

                <li class="page-item">
                    <a class="page-link" href="#">2</a>
                </li>

                <li class="page-item">
                    <a class="page-link" href="#">3</a>
                </li>

                <li class="page-item">
                    <a class="page-link" href="#">Next</a>
                </li>
            </ul>
        </nav>

        <!-- About Section -->
        <section id="about" class="text-center my-5">
            <h2>🌎 Protect Our Oceans</h2>
            <p>
                Oceans are home to millions of living organisms.
                Keeping our oceans clean and healthy helps protect
                marine life for the future.
            </p>

            <button class="btn btn-primary">
                Explore More
            </button>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-primary text-white text-center p-3">
        <p class="mb-0">🌊 My Ocean World © 2026</p>
    </footer>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>